#!/usr/bin/env bash
# Avoid unnecessary reboots: don't notify if an updated package is
# - not currently running (e.g. alternative kernel)
# - not in use (e.g. alternative driver)

kernelname="$(grep -oP '\(\K.*(?=@.*\))' /proc/version)"

export TEXTDOMAIN=cachyos-hooks
export TEXTDOMAINDIR=/usr/share/locale

# Sets lc and language from the environment given as NAME=value lines:
# lc is the first of LC_ALL, LC_MESSAGES, LANG that is set, language is
# LANGUAGE. gettext then picks the translation as it would for that session.
_locale() {
    local env="$1" var
    for var in LC_ALL LC_MESSAGES LANG; do
        lc="$(sed -n "s/^$var=//p" <<< "$env")"
        [ -n "$lc" ] && break
    done
    language="$(sed -n "s/^LANGUAGE=//p" <<< "$env")"
}

_gettext() {
    LC_ALL="${lc:-C}" LANGUAGE="$language" gettext "$1"
}

# Sets header, title and msg in the language picked by _locale.
# Translations live in po/; any language without one gets English.
_strings() {
    header="$(_gettext "CachyOS Update")"
    title="$(_gettext "Reboot recommended!")"
    msg="$(_gettext "Reboot is recommended due to the upgrade of core system package(s).")"
}

_notify() {
    local header title msg lc language

    # at TTY, in the language of whoever runs pacman
    _locale "$(env)"
    _strings
    echo "==> INFO: $msg" >&2

    for user in $(users | sed 's| |\n|g' | sort | uniq); do
        # pacman's environment is often reset (e.g. under pkexec), so take the
        # language from the user's own session instead
        _locale "$(systemctl --machine="${user}@.host" --user show-environment 2>/dev/null)"
        _strings

        # See https://specifications.freedesktop.org/notification-spec/1.2/protocol.html#command-notify
        busctl --machine="${user}@.host" --user call org.freedesktop.Notifications \
            /org/freedesktop/Notifications \
            org.freedesktop.Notifications  \
            Notify susssasa\{sv\}i \
            "$header" \
            0 \
            system-reboot \
            "$title" \
            "$msg" \
            0 \
            1 urgency y 0x2 \
            10000 &>/dev/null
    done
    exit 0
}

while read -r target; do
    case "$target" in
        "$kernelname") _notify;;
        nvidia)
            [ "$kernelname" = "linux" ] && _notify;;
        nvidia-lts)
            [ "$kernelname" = "linux-lts" ] && _notify;;
        linux-cachyos-nvidia*)
            [[ "$kernelname" = linux-cachyos* ]] && _notify;;
        btrfs-progs)
            [ -n "$(mount -t btrfs)" ] && _notify || : ;;
        xfsprogs)
            [ -n "$(mount -t xfs)" ] && _notify || : ;;
        e2fsprogs)
            [ -n "$(mount -t ext4)" ] && _notify || : ;;
        *) _notify ;;
    esac
done
